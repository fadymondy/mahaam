# The Mahaam Go API origin. next.config.mjs proxies /api and /graphql to it, and proxy.ts
# asks it who the viewer is. Defaults to http://localhost:8110.
API_ORIGIN=http://localhost:8110

# Shown in the ready-to-paste `claude mcp add` line on the MCP tokens screen.
# Defaults to http://localhost:8110 (the MCP endpoint is <origin>/api/mcp).
NEXT_PUBLIC_MCP_ORIGIN=http://localhost:8110

# The public Support and Delete-your-account pages (/support, /delete-account): where people write
# for help, and the developer name the store listings show. Default to info@3x1.io / Fady Mondy.
NEXT_PUBLIC_SUPPORT_EMAIL=info@3x1.io
NEXT_PUBLIC_DEVELOPER_NAME=Fady Mondy
