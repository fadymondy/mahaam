{
    "name": "mahaam/feedback",
    "description": "Mahaam Feedback widget for Laravel: @mahaamFeedback Blade directive and server-side issue reporting.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": { "Mahaam\\Feedback\\": "src/" },
        "files": ["src/aliases.php"]
    },
    "autoload-dev": {
        "psr-4": { "Mahaam\\Feedback\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Mahaam\\Feedback\\FeedbackServiceProvider"],
            "aliases": {
                "MahaamFeedback": "Mahaam\\Feedback\\Facades\\MahaamFeedback",
                "ManagyFeedback": "Mahaam\\Feedback\\Facades\\MahaamFeedback",
                "MahaamMonitor": "Mahaam\\Feedback\\Facades\\MahaamMonitor"
            }
        }
    },
    "minimum-stability": "stable"
}
