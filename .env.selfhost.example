# Secrets for docker-compose.selfhost.yml. Copy to .env.selfhost (git-ignored) and fill in.
# Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
MAHAAM_APP_DB_PASSWORD=
AUTH_SECRET=
MAHAAM_SECRET_KEY=

# Public origin (no trailing slash). Behind HTTPS also set COOKIE_SECURE=1.
APP_URL=http://localhost:3010
COOKIE_SECURE=0
WEB_PORT=3010
# Plan new workspaces start on: free | pro | business | unlimited
PLAN_DEFAULT=unlimited
