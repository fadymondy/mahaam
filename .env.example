# Mahaam — local development. Copy to .env and fill the two secrets.
# Ports: API :8110, web :3010, Postgres (docker compose) :55460. See README.

# ─── Core ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8110
ADDR=:8110

# ─── Database ────────────────────────────────────────────────────────────
# Two roles on purpose (README, "Tenancy"):
#   DATABASE_URL      the OWNER role — migrations, auth, tenant resolution, admin MCP
#   APP_DATABASE_URL  the APP role — no superuser, no BYPASSRLS, owns nothing; every
#                     generated route runs on it with row-level security enforced.
# `togo migrate` creates/updates the app role from APP_DATABASE_URL.
DB_DRIVER=pgx
DATABASE_URL=postgres://postgres:postgres@localhost:55460/mahaam?sslmode=disable
APP_DATABASE_URL=postgres://mahaam_app:CHANGE_ME@localhost:55460/mahaam?sslmode=disable

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text

# ─── i18n / storage ──────────────────────────────────────────────────────
LOCALE=en
LOCALE_DIR=lang
STORAGE_DIR=storage
CACHE_DRIVER=memory

# ─── Auth (togo-framework/auth) ──────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_TO_48_RANDOM_CHARS
AUTH_DRIVER=base
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie
COOKIE_SECURE=
CORS_ORIGINS=http://localhost:3010

# OAuth (togo-framework/auth-oauth). Unset = the sign-in buttons are not shown.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ─── Mail ────────────────────────────────────────────────────────────────
# P5: notification email and the daily digest (togo mail). Invitations still return a one-time link.
#   file  write each message to MAIL_DIR (default STORAGE_DIR/mail) — development; nothing is sent
#   log   log recipient + subject only
#   smtp  deliver: MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION, MAIL_FROM
# The settings page shows "email is not configured" unless the driver delivers (smtp).
MAIL_DRIVER=file
MAIL_FROM=Mahaam <no-reply@mahaam.local>
# Links in email point here.
WEB_URL=http://localhost:3010

# MCP rate limits (per minute): calls per token, and failed authentications per client address.
MCP_RATE_PER_MINUTE=120
MCP_AUTH_FAIL_PER_MINUTE=30

# ─── Secrets at rest (internal/secretbox) ────────────────────────────────
# AES-256-GCM key for integration credentials (Jira/Linear tokens) and signed install state.
# 32 bytes, base64:  openssl rand -base64 32
# REQUIRED when APP_ENV=production (boot fails without it); dev derives a key and warns.
# Every MAHAAM_* variable falls back to its pre-rebrand MANAGY_* name (e.g. MANAGY_SECRET_KEY),
# so an existing deployment keeps working; prefer the MAHAAM_* names for new setups.
# Rotation: move the old key to MAHAAM_SECRET_KEY_PREVIOUS as "<id>:<key>" and bump the id.
MAHAAM_SECRET_KEY=
# MAHAAM_SECRET_KEY_ID=1
# MAHAAM_SECRET_KEY_PREVIOUS=

# ─── Integrations (internal/integrations) ────────────────────────────────
# GitHub App (per-project repo link: issues both ways, PRs, commits, runs, deploys).
#   Setup URL (callback):  <APP_URL>/api/integrations/github/callback   (tick "Redirect on update")
#   Webhook URL:           <APP_URL>/api/integrations/github/webhook
#   Permissions: Issues RW, Pull requests R, Contents R, Actions RW, Deployments R, Metadata R.
#   Events: issues, issue_comment, push, pull_request, deployment_status, workflow_run.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=/path/to/app.private-key.pem   # or the PEM itself (\n escapes allowed)
# GITHUB_WEBHOOK_SECRET=
# The App's OAuth client — proves the installing GitHub user owns the installation.
# Required in production ("Request user authorization (OAuth) during installation" on the App).
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_API_URL=https://api.github.com   # GitHub Enterprise only
# GITHUB_WEB_URL=https://github.com
# "Connect GitHub" (employee KPI): members authorize the same App as themselves. Add
#   <APP_URL>/api/integrations/github/user-callback to the App's "Callback URLs" and give it the
#   account permission "Email addresses: read" (verified commit e-mails). Override the callback with:
# GITHUB_USER_REDIRECT_URL=
# Jira import: *.atlassian.net only, unless the host is listed here (comma-separated).
# JIRA_ALLOWED_HOSTS=
# Hosbah hosting (internal/integrations/hosbah.go): the Hosbah control plane a project connects to.
# A connect form may name another Hosbah only if its host is listed in HOSBAH_ALLOWED_HOSTS.
# HOSBAH_URL=https://dev.hosbah.com
# HOSBAH_ALLOWED_HOSTS=

# ─── Customer import (internal/work/client_import*.go) ───────────────────
# Google Contacts: an OAuth client (type "Web application") with the People API enabled and the
# redirect URI  <APP_URL>/api/integrations/google/callback  (GOOGLE_REDIRECT_URL overrides it).
# Scope: contacts.readonly. The access token is used once per import and never stored.
# Unset = the Google tab says "not configured"; CSV exports from Google Contacts still import.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=
# WhatsApp Business / Evolution API contacts (optional). Unset = "not configured"; a vCard
# export of the phone's / WhatsApp contacts always imports.
# WHATSAPP_API_URL=https://evolution.example.com
# WHATSAPP_API_TOKEN=
# WHATSAPP_INSTANCE=

# Proxies whose X-Forwarded-For / X-Real-IP the API trusts (IPs or CIDRs, comma-separated).
# Anything else has those headers stripped before any handler (rate limiters key on them).
# Default: loopback only. Behind the tunnel / reverse proxy, list that hop.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ---- Plans and billing (README "Platform admin and plans", "Billing (Polar)") ----
# Plan a NEW workspace starts on (existing workspaces were moved to `unlimited` by the migration).
PLAN_DEFAULT=free
# Where "Contact us to upgrade" points (email or URL).
PLAN_UPGRADE_CONTACT=sales@mahaam.app
# Polar (merchant of record). Organization access token — never commit a real one.
POLAR_ACCESS_TOKEN=
POLAR_API_URL=https://api.polar.sh
# Secret of the webhook endpoint https://console.mahaam.app/api/billing/polar/webhook
POLAR_WEBHOOK_SECRET=
# Where Polar sends the buyer after paying ({locale} and {slug} are filled in).
POLAR_SUCCESS_URL=https://console.mahaam.app/{locale}/w/{slug}/settings/plan?paid=1

# Web Push for the installed app (PWA). Generate with: mahaam-admin vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@3x1.io
# Mahaam's own error monitoring (MH-129): a DSN from Mahaam's own project (Settings → Monitoring).
# Every Error log and every panic becomes an issue on that board. Empty = off (development, tests).
MAHAAM_DSN=
# Email confirmation on sign-up (MH-342): auto (default) = required only when MAIL_DRIVER really
# delivers, so a server without SMTP never locks new accounts out; required; or off. Unconfirmed
# accounts can use workspaces they're invited to but can't create one.
EMAIL_VERIFICATION=auto
# Native push for the mobile apps (MH-352), through Firebase Cloud Messaging (APNs relayed by
# Firebase for iOS). Both empty = native push off; Web Push is unaffected. The service account is
# the JSON inline or a path to it. It is a credential: keep it in the vault, never in a repo.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=
# iOS Live Activity (MH-355): the app's ActivityAttributes type, which a push-to-start must name
# exactly, and the per-person throttle on widget reload pushes.
LIVE_ACTIVITY_ATTRIBUTES_TYPE=TimerActivityAttributes
WIDGET_REFRESH_SECONDS=600

# CircleXO hub integration (docs/circlexo.md). Everything is off unless CIRCLEXO_ISSUER is set.
# The values come from the hub's app registration and are credentials: keep them in the vault.
CIRCLEXO_ISSUER=
CIRCLEXO_API_URL=
CIRCLEXO_APP_ID=
CIRCLEXO_CLIENT_ID=
# One of the two: a client secret, or a private key (PEM) with its key id.
CIRCLEXO_CLIENT_SECRET=
CIRCLEXO_PRIVATE_KEY=
CIRCLEXO_KEY_ID=
# The app key the hub's app API takes (entitlements, tenants, org members).
CIRCLEXO_APP_KEY=
# The signing secret for the hub's webhooks and the provision/deprovision calls (whsec_...).
CIRCLEXO_WEBHOOK_SECRET=
# Seals the sign-in state cookie (16+ characters). Empty = derived from MAHAAM_SECRET_KEY.
CIRCLEXO_SESSION_KEY=
# Optional. Default: WEB_URL (or APP_URL) + /auth/circlexo/callback.
CIRCLEXO_REDIRECT_URL=
# Optional. Hub billing page for a linked workspace; {slug} is the org slug. Default: <issuer>/orgs/{slug}/billing.
CIRCLEXO_BILLING_URL=
