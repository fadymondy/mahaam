# Managy — local development. Copy to .env and fill the two secrets.
# Ports: API :8110, web :3010, Postgres (docker compose) :55460. See README.

# ─── Core ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8110
ADDR=:8110

# ─── Database ────────────────────────────────────────────────────────────
# Two roles on purpose (README, "Tenancy"):
#   DATABASE_URL      the OWNER role — migrations, auth, tenant resolution, admin MCP
#   APP_DATABASE_URL  the APP role — no superuser, no BYPASSRLS, owns nothing; every
#                     generated route runs on it with row-level security enforced.
# `togo migrate` creates/updates the app role from APP_DATABASE_URL.
DB_DRIVER=pgx
DATABASE_URL=postgres://postgres:postgres@localhost:55460/managy?sslmode=disable
APP_DATABASE_URL=postgres://managy_app:CHANGE_ME@localhost:55460/managy?sslmode=disable

# ─── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=text

# ─── i18n / storage ──────────────────────────────────────────────────────
LOCALE=en
LOCALE_DIR=lang
STORAGE_DIR=storage
CACHE_DRIVER=memory

# ─── Auth (togo-framework/auth) ──────────────────────────────────────────
AUTH_SECRET=CHANGE_ME_TO_48_RANDOM_CHARS
AUTH_DRIVER=base
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie
COOKIE_SECURE=
CORS_ORIGINS=http://localhost:3010

# OAuth (togo-framework/auth-oauth). Unset = the sign-in buttons are not shown.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ─── Mail ────────────────────────────────────────────────────────────────
# Not used in P0: invitations return a one-time link instead of sending email.
MAIL_DRIVER=log
