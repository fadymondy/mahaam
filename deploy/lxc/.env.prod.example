# Managy PRODUCTION — Proxmox LXC 116. Copy to .env.prod on the LXC and fill in.
# DB is pg-shared (LXC 102, 10.10.10.102:5432).
APP_ENV=production
APP_URL=https://managy-app.fadymondy.com
ADDR=:8110

DB_DRIVER=pgx
# Owner role must have BYPASSRLS: togo's boot inserts a platform workspace and RLS
# would otherwise block it (locally this role was the superuser postgres).
DATABASE_URL=postgres://managy:__OWNER_PASSWORD__@10.10.10.102:5432/managy?sslmode=disable
# App role: RLS-enforced, no bypass.
APP_DATABASE_URL=postgres://managy_app:__APP_PASSWORD__@10.10.10.102:5432/managy?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=text

LOCALE=en
LOCALE_DIR=lang
STORAGE_DIR=storage
CACHE_DRIVER=memory

AUTH_SECRET=__AUTH_SECRET__
AUTH_DRIVER=base
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie
COOKIE_SECURE=1
CORS_ORIGINS=https://managy-app.fadymondy.com

MAIL_DRIVER=file
MAIL_FROM=Managy <no-reply@managy.local>
WEB_URL=https://managy-app.fadymondy.com

MCP_RATE_PER_MINUTE=120
MCP_AUTH_FAIL_PER_MINUTE=30
