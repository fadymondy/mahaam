# Mahaam PRODUCTION — Proxmox LXC 116. Copy to .env.prod on the LXC and fill in.
# DB is pg-shared (LXC 102, 10.10.10.102:5432).
APP_ENV=production
APP_URL=https://console.mahaam.app
ADDR=:8110

DB_DRIVER=pgx
# Owner role must have BYPASSRLS: togo's boot inserts a platform workspace and RLS
# would otherwise block it (locally this role was the superuser postgres).
DATABASE_URL=postgres://mahaam:__OWNER_PASSWORD__@10.10.10.102:5432/mahaam?sslmode=disable
# App role: RLS-enforced, no bypass.
APP_DATABASE_URL=postgres://mahaam_app:__APP_PASSWORD__@10.10.10.102:5432/mahaam?sslmode=disable

LOG_LEVEL=info
LOG_FORMAT=text

LOCALE=en
LOCALE_DIR=lang
STORAGE_DIR=storage
CACHE_DRIVER=memory

AUTH_SECRET=__AUTH_SECRET__
AUTH_DRIVER=base
AUTH_TTL_HOURS=24
AUTH_MIN_PASSWORD=8
SESSION_DRIVER=cookie
COOKIE_SECURE=1
CORS_ORIGINS=https://console.mahaam.app
# The old host (managy-app.fadymondy.com) can keep pointing at the same web container; the web
# app proxies /api, so it works from either host.

# Secrets at rest (internal/secretbox). REQUIRED in production: openssl rand -base64 32
# Falls back to the pre-rebrand MANAGY_SECRET_KEY (and _ID / _PREVIOUS) when unset, so an
# existing .env.prod that still has MANAGY_SECRET_KEY keeps decrypting stored credentials.
MAHAAM_SECRET_KEY=
# MAHAAM_SECRET_KEY_ID=1
# MAHAAM_SECRET_KEY_PREVIOUS=

MAIL_DRIVER=file
MAIL_FROM=Mahaam <no-reply@mahaam.local>
WEB_URL=https://console.mahaam.app

MCP_RATE_PER_MINUTE=120
MCP_AUTH_FAIL_PER_MINUTE=30

# ---- Plans and billing (README "Platform admin and plans", "Billing (Polar)") ----
# Plan a NEW workspace starts on (existing workspaces were moved to `unlimited` by the migration).
PLAN_DEFAULT=free
# Where "Contact us to upgrade" points (email or URL).
PLAN_UPGRADE_CONTACT=sales@mahaam.app
# Polar (merchant of record). Organization access token — never commit a real one.
POLAR_ACCESS_TOKEN=
POLAR_API_URL=https://api.polar.sh
# Secret of the webhook endpoint https://console.mahaam.app/api/billing/polar/webhook
POLAR_WEBHOOK_SECRET=
# Where Polar sends the buyer after paying ({locale} and {slug} are filled in).
POLAR_SUCCESS_URL=https://console.mahaam.app/{locale}/w/{slug}/settings/plan?paid=1
