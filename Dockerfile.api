# Mahaam Go API — production image. Compiled static binary (pgx is pure Go, so
# CGO is off), not `go run`. Built and run by docker-compose.prod.yml.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
# github.com/circlexo/circlexo-go is a private module. The token is an OPTIONAL BuildKit secret,
# read only for this one step and handed to git through per-process environment config, so it is
# never an ARG or ENV and is written to no file, layer or history:
#   docker build --secret id=CIRCLEXO_GO_TOKEN,env=CIRCLEXO_GO_TOKEN -f Dockerfile.api .
# Without the secret the step is the plain `go mod download` it always was; it fails only if the
# module cannot be reached anonymously.
ENV GOPRIVATE=github.com/circlexo/*
RUN --mount=type=secret,id=CIRCLEXO_GO_TOKEN,required=false \
    if [ -s /run/secrets/CIRCLEXO_GO_TOKEN ]; then \
      GIT_CONFIG_COUNT=1 \
      GIT_CONFIG_KEY_0="url.https://x-access-token:$(cat /run/secrets/CIRCLEXO_GO_TOKEN)@github.com/circlexo/.insteadOf" \
      GIT_CONFIG_VALUE_0="https://github.com/circlexo/" \
      go mod download; \
    else \
      go mod download; \
    fi
COPY . .
# internal/db/gen and internal/graph/gen are gitignored: generate them, so a clean
# git checkout (Hosbah builds straight from the repository) compiles.
COPY --from=sqlc/sqlc:1.31.1 /workspace/sqlc /usr/local/bin/sqlc
RUN sqlc generate && go run github.com/99designs/gqlgen generate
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/api ./cmd/api \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/migrate ./cmd/migrate \
 && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags "-s -w" -o /out/mahaam-admin ./cmd/mahaam-admin

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 app
WORKDIR /app
COPY --from=build /out/api /app/api
# cmd/migrate applies internal/db/{schema,post} relative to /app: `docker compose run --rm api /app/migrate`
COPY --from=build /out/migrate /app/migrate
# Platform ops on the server: promote/demote, admin tokens, polar-sync, mail-test
# (`docker compose exec api /app/mahaam-admin …`).
COPY --from=build /out/mahaam-admin /app/mahaam-admin
COPY internal/db/schema ./internal/db/schema
COPY internal/db/post ./internal/db/post
# The embeddable Feedback widget (make embed), served at /embed/v1.js (EMBED_DIR default embed/dist).
COPY embed/dist ./embed/dist
COPY lang ./lang
COPY togo.yaml ./togo.yaml
RUN mkdir -p storage/mail storage/logs storage/attachments && chown -R app:app /app
USER app
EXPOSE 8110
CMD ["/app/api"]
