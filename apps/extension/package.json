{
  "name": "@mahaam/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mahaam — Chrome MV3 extension: timer, next tasks and page issues.",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "node scripts/icons.mjs && vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@mahaam/client": "*",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  }
}
