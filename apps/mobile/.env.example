# Mahaam mobile — build-time configuration (EXPO_PUBLIC_* is compiled into the app; set them per
# profile in eas.json or in the shell for local builds). Never commit real values.
EXPO_PUBLIC_API_URL=https://console.mahaam.app
EXPO_PUBLIC_WEB_URL=https://console.mahaam.app
# @mahaam/react-native: project Settings → Monitoring (mdsn_…) and Settings → Feedback (pfk_…,
# allowlist app://com.fadymondy.mahaam on the key). Unset = off.
EXPO_PUBLIC_MAHAAM_DSN=
EXPO_PUBLIC_MAHAAM_FEEDBACK_KEY=
