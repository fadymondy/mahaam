{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "24.19.0" },
    "development": {
      "extends": "base", "developmentClient": true, "distribution": "internal", "channel": "development",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:8120" }
    },
    "preview": {
      "extends": "base", "distribution": "internal", "channel": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://console.mahaam.app" }
    },
    "production": {
      "extends": "base", "autoIncrement": true, "channel": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://console.mahaam.app" }
    }
  },
  "submit": {
    "production": {}
  }
}
