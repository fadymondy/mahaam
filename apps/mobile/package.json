{
  "name": "@mahaam/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@codemagic/react-native-patch": "^0.5.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/ui": "~58.0.20",
    "@expo/vector-icons": "^15.0.2",
    "@mahaam/react-native": "github:fadymondy/mahaam-react-native#0010a8f7eb45c8c4c97a700dfe240ad53d3a449a",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@tanstack/query-async-storage-persister": "^5.104.4",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-persist-client": "^5.104.4",
    "expo": "~58.0.14",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-print": "~58.0.6",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "lucide-react-native": "^1.59.0",
    "marked": "^18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "icons": "node scripts/make-icons.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "doctor": "expo-doctor",
    "lint": "expo lint",
    "gen:types": "node scripts/gen-types.mjs",
    "grid:sync": "node ../../../fadymondy.com/packages/sync-grid.mjs native .",
    "grid:check": "node ../../../fadymondy.com/packages/sync-grid.mjs native . --check",
    "export:web": "expo export --platform web --clear --output-dir dist/web"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@tanstack/.*|react-native-svg|standard-navigation|marked)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^@mahaam/react-native$": "<rootDir>/node_modules/@mahaam/react-native/src/index.ts",
      "^@mahaam/react-native/(.*)$": "<rootDir>/node_modules/@mahaam/react-native/src/$1"
    }
  }
}
