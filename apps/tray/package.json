{
  "name": "@mahaam/tray",
  "version": "0.1.0",
  "private": true,
  "description": "Mahaam — the employee tray / menu-bar timer.",
  "author": "Fady Mondy <info@3x1.io>",
  "homepage": "https://mahaam.app",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs && node scripts/icons.mjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@mahaam/client": "*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.fadymondy.mahaam.tray",
    "productName": "Mahaam",
    "copyright": "Copyright © 2026 Fady Mondy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "extendInfo": {
        "LSUIElement": true
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Fady Mondy <info@3x1.io>"
    },
    "afterSign": "scripts/notarize.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "fadymondy",
        "repo": "mahaam",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
