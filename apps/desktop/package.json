{
  "name": "@mahaam/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Mahaam for macOS, Windows and Linux \u2014 the web console in a native window.",
  "author": "Fady Mondy <info@3x1.io>",
  "homepage": "https://mahaam.app",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build-main.mjs",
    "dev": "node scripts/build-main.mjs && electron .",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@mahaam/client": "*",
    "@types/node": "^24.0.0",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.fadymondy.mahaam.desktop",
    "productName": "Mahaam",
    "copyright": "Copyright \u00a9 2026 Fady Mondy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "static/**",
      "package.json"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Mahaam",
        "schemes": [
          "mahaam"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/Mahaam.icon",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Fady Mondy <info@3x1.io>"
    },
    "afterSign": "scripts/notarize.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "fadymondy",
        "repo": "mahaam",
        "releaseType": "release"
      }
    ]
  }
}
