{
  "name": "@mahaam/desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Mahaam for macOS, Windows and Linux \u2014 a native desktop client with a menu-bar timer.",
  "author": "Fady Mondy <info@3x1.io>",
  "homepage": "https://mahaam.app",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/notarize": "^2.5.0",
    "@mahaam/client": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.462.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.fadymondy.mahaam.desktop",
    "productName": "Mahaam",
    "copyright": "Copyright \u00a9 2026 Fady Mondy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Mahaam",
        "schemes": [
          "mahaam"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/Mahaam.icon",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "Fady Mondy <info@3x1.io>"
    },
    "afterSign": "scripts/notarize.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "fadymondy",
        "repo": "mahaam",
        "releaseType": "release"
      }
    ]
  }
}
