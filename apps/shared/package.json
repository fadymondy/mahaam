{
  "name": "@mahaam/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed Mahaam API client, SSE parser, brand tokens and the shared employee panel UI.",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./brand": "./src/brand/index.ts",
    "./brand/png": "./src/brand/png.ts",
    "./tokens.css": "./src/brand/tokens.css",
    "./panel.css": "./src/ui/panel.css",
    "./grid.css": "./src/ui/grid.css"
  },
  "scripts": {
    "gen:types": "node scripts/gen-types.mjs",
